# Firebase project config (get from Firebase Console → Project Settings → Your apps)
PUBLIC_FIREBASE_API_KEY=REMOVED
PUBLIC_FIREBASE_AUTH_DOMAIN=REMOVED
PUBLIC_FIREBASE_PROJECT_ID=kovawebsite
PUBLIC_FIREBASE_STORAGE_BUCKET=REMOVED
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REMOVED
PUBLIC_FIREBASE_APP_ID=1:REMOVED:web:36bcda41af10909b0b37a0
PUBLIC_FIREBASE_MEASUREMENT_ID=REMOVED

# Google reCAPTCHA Enterprise site key (get from Google Cloud Console → reCAPTCHA Enterprise)
PUBLIC_RECAPTCHA_SITE_KEY=

# URL of the Firebase Cloud Function that handles waitlist signups
# After deploying, find this in Firebase Console → Functions → website_joinWaitlist → trigger URL
# Format: https://us-central1-kovawebsite.cloudfunctions.net/website_joinWaitlist
PUBLIC_WAITLIST_FUNCTION_URL=
